# .clineignore - patterns Cline must not load into context (gitignore syntax).
#
# This repository tracks two vendored Maven repositories: ~2,780 of its ~2,807
# tracked files. They are build inputs, not source, and loading them makes the
# context window unusable. Everything Cline actually needs stays visible:
# src/**, pom.xml, .env.example, README.md, .gitignore, offline-settings.xml,
# mvnw / mvnw.cmd, the Python and shell launchers, and .clinerules/ + this file.
#
# NOTE: .clineignore only filters automatic context loading. Explicit @ mentions and
# shell commands still reach ignored paths, which is why .clinerules/00-guardrails.md
# restates the hard constraints.

# Vendored offline Maven repositories (tracked on purpose - do not delete).
# NOTE: gitignore syntax has no inline comments - a "#" only starts a comment at the
# start of a line - so every pattern below stands alone on its line.
local-repo/

# Accidental duplicate commit (1,146 files created by a mis-quoted Maven invocation):
# unused junk, slated for removal - see "Offline Maven notes" in README.md.
local-repo -DskipTests/

# Build output, Gatling reports, captured request/response payloads
target/
*.class
*.jar
*.war

# Runtime state written by run_queue.py (one directory/file per execution)
queue/
logs/
results/

# SLURM and launcher console output
*.out
*.err

# Local deployment configuration (real host, prompt, credentials) - use .env.example
.env

# Generated by the maven-shade-plugin; pom.xml is the build file
dependency-reduced-pom.xml

# Generated Maven wrapper internals
.mvn/wrapper/MavenWrapperDownloader.java

# Python and OS noise
__pycache__/
*.pyc
.DS_Store
Thumbs.db
