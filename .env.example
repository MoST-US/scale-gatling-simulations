LLM_URL=gpu06:9000
ENDPOINT_PATH=/v1/completions
MODELS_ENDPOINT=/v1/models
CAPTURE_RESPONSES=false
CAPTURE_REQUESTS=false
SIMULATION_MINUTES=60
USER_RAMP_MINUTES=30
INTERACT_DURING_RAMP=true   # false: wait until all users arrive before any request (current behavior)
FIRST_REQUEST_BATCH_SIZE=500
FIRST_REQUEST_TURN_INTERVAL_SECONDS=2
LOOSENESS=20
TOTAL_USERS=10000
LOW_USAGE_REQUESTS_PER_HOUR=10
HIGH_USAGE_REQUESTS_PER_HOUR=50
HIGH_USAGE_USER_SHARE=0.5
BASIC_SHARE=0.7
STANDARD_SHARE=0.2
PRO_SHARE=0.1
UNITS_PER_REQUEST=100
MAX_ACCUMULATED_REQUESTS=1        # Per-user burst capacity; 1 means at most one stored request
MIN_OUTPUT_LENGTH=1
MAX_OUTPUT_LENGTH=100
USER_RATE_LIMITS=50,100,150   # Per-user units per minute: basic,standard,pro
LLM_PROMPT="Please provide me with a list of the 100 most well known global (brand) names, trademarks, social media account names or other important terms such as blockchain, music, art, computer, games. And think of brands such as Google, Facebook, Walmart, Aliexpress, etc. Provide this in a machine readable CSV format. Use one row per brand and sort the list by importance. I need the following columns: Brand Name, Valuation (in million euros), Yearly revenue (in million euros), Number of employees and the Year the brand was established."